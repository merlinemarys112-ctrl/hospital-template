# Backend env — copy to apps/backend/.env

DATABASE_URL=postgres://postgres:postgres@localhost:5432/marline
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
CSRF_ORIGINS=http://localhost:3001
REVALIDATE_SECRET=change-me-revalidate
CRON_SECRET=change-me-cron

# Isolation tests only (docker compose service postgres-test on host port 5433)
